# iFleetPro local/development configuration template.
# Copy to .env locally and replace placeholders. Never commit real credentials.
DATABASE_URL=mariadb://<user>:<password>@<host>:3306/<database>
NEXTAUTH_SECRET=<generate-a-strong-random-value>
INTERNAL_API_KEY=<generate-a-service-api-key>
AI_SERVICE_URL=http://127.0.0.1:3007
WARMUP_SECRET=<generate-a-warmup-secret>

# Optional integrations
GROQ_API_KEY=<optional-groq-api-key>
GROQ_MODEL=<optional-model-name>
HUBTEL_CLIENT_ID=<optional-hubtel-client-id>
HUBTEL_API_SECRET=<optional-hubtel-api-secret>
SMTP_HOST=<optional-smtp-host>
SMTP_PORT=587
SMTP_USER=<optional-smtp-user>
SMTP_PASS=<optional-smtp-password>
SMTP_FROM=<optional-from-address>
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=<optional-upload-directory>