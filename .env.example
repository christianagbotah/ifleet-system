# Local/staging example only. Never commit real credentials.
DATABASE_URL=mariadb://ifleet_dev@127.0.0.1:3306/ifleetpro_dev
ALLOW_PRODUCTION_DB_IN_DEV=false
NEXTAUTH_SECRET=<set-in-local-or-server-environment>

# Server-only machine ingestion authentication. Never expose these to browser code.
MACHINE_INGEST_KEY_ID=<set-on-server>
MACHINE_INGEST_SECRET=<set-on-server>
MACHINE_NONCE_DIR=/tmp/ifleetpro-machine-nonces

# Public demo access is disabled unless explicitly enabled.
# DEMO_PROFILES_JSON is server-side JSON metadata only: no email, password, phone,
# employee number, secret, token, or API key fields are accepted.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_ALLOW_PRODUCTION=false
DEMO_SESSION_TTL=
DEMO_PROFILES_JSON=

# Production bootstrap seed. Disabled unless explicitly enabled.
# Supply bootstrap identity and credentials through the server environment only.
SEED_BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_POSITION=
BOOTSTRAP_ADMIN_DEPARTMENT=

# Telematics history retention / compaction.
# Events newer than the retention window are never compacted.
TELEMATICS_RETENTION_DAYS=30
TELEMATICS_COMPACTION_BUCKET_MINUTES=15
TELEMATICS_COMPACTION_BATCH_SIZE=5000
# Optional server-side video provider gateway. The browser never receives this API key.
VIDEO_PROVIDER_GATEWAY_URL=
VIDEO_PROVIDER_GATEWAY_API_KEY=
