model GateEvent {
  id         String   @id @default(cuid())
  siteId     String
  siteName   String?
  truckId    String
  driverId   String?
  tripId     String?
  direction  String
  occurredAt DateTime @default(now())
  actorId    String
  latitude   Float?
  longitude  Float?
  evidence   String?  @db.Text
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@index([siteId, truckId, occurredAt])
  @@index([tripId, occurredAt])
  @@index([direction, occurredAt])
}

model FactoryQueueEntry {
  id                   String   @id @default(cuid())
  legacyQueueId        String?  @unique
  siteId               String
  siteName             String
  truckId              String
  driverId             String?
  tripId               String?
  queueType            String
  status               String   @default("waiting")
  position             Int?
  bayId                String?
  joinedAt             DateTime @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  estimatedWait        Int?
  actualWait           Int?
  detentionFreeMinutes Int?
  detentionMinutes     Int      @default(0)
  notes                String?  @db.Text
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([siteId, status, position])
  @@index([truckId, status])
  @@index([tripId])
  @@index([joinedAt])
}
