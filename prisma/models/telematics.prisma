model TelematicsDevice {
  id            String   @id @default(cuid())
  name          String
  provider      String
  deviceType    String
  imei          String?  @unique
  serialNumber  String?  @unique
  credentialRef String?
  status        String   @default("active")
  metadata      String?  @db.Text
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  installations       DeviceInstallationHistory[]
  events               TelematicsEvent[]
  cameraChannels       CameraChannel[]
  videoRetentionPolicy VideoRetentionPolicy?
  videoAlarmEvents     VideoAlarmEvent[]
  videoMediaRecords    VideoMediaRecord[]

  @@index([provider, status])
  @@index([deviceType, status])
  @@index([lastSeenAt])
}

model DeviceInstallationHistory {
  id            String   @id @default(cuid())
  deviceId      String
  assetType     String
  assetId       String
  installedAt   DateTime
  uninstalledAt DateTime?
  installedById String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  device TelematicsDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([deviceId, installedAt])
  @@index([deviceId, uninstalledAt])
  @@index([assetType, assetId, installedAt])
}

model TelematicsEvent {
  id              String   @id @default(cuid())
  eventType       String
  deviceId        String?
  provider        String
  providerEventId String?
  idempotencyKey  String   @unique
  assetType       String?
  assetId         String?
  tripId          String?
  deviceTimestamp DateTime
  receivedAt      DateTime @default(now())
  latitude        Float?
  longitude       Float?
  speedKph        Float?
  headingDeg      Float?
  accuracyMeters  Float?
  ignitionOn      Boolean?
  sensorType      String?
  sensorValue     String?  @db.Text
  sensorUnit      String?
  alarmType       String?
  severity        String?
  message         String?  @db.Text
  source          String
  trust           String
  rawEventRef     String
  normalizedPayload String? @db.Text
  createdAt       DateTime @default(now())

  device TelematicsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([assetType, assetId, deviceTimestamp])
  @@index([tripId, deviceTimestamp])
  @@index([deviceId, deviceTimestamp])
  @@index([rawEventRef])
  @@index([provider, providerEventId])
  @@index([eventType, receivedAt])
}

model RawTelematicsPacket {
  id              String   @id
  provider        String
  deviceId        String?
  providerEventId String?
  idempotencyKey String   @unique
  payloadHash     String
  payload         String   @db.LongText
  receivedAt      DateTime
  createdAt       DateTime @default(now())

  @@index([provider, providerEventId])
  @@index([deviceId, receivedAt])
  @@index([receivedAt])
}

model VehicleLiveState {
  id               String   @id @default(cuid())
  assetType        String
  assetId          String
  latestEventId    String
  deviceId         String?
  tripId           String?
  provider         String
  latitude         Float?
  longitude        Float?
  speedKph         Float?
  headingDeg       Float?
  accuracyMeters   Float?
  ignitionOn       Boolean?
  source           String
  trust            String
  deviceTimestamp  DateTime
  receivedAt       DateTime
  updatedAt        DateTime @updatedAt

  @@unique([assetType, assetId])
  @@index([tripId, deviceTimestamp])
  @@index([deviceId, deviceTimestamp])
  @@index([deviceTimestamp])
}

model TelematicsHistorySummary {
  id              String   @id @default(cuid())
  idempotencyKey  String   @unique
  assetType       String
  assetId         String
  tripId          String?
  bucketStart     DateTime
  bucketEnd       DateTime
  bucketMinutes   Int
  pointCount      Int
  minSpeedKph     Float?
  maxSpeedKph     Float?
  startLatitude   Float
  startLongitude  Float
  endLatitude     Float
  endLongitude    Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assetType, assetId, bucketStart])
  @@index([tripId, bucketStart])
  @@index([bucketEnd])
}
