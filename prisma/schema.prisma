  lastRestocked DateTime?
  expiryDate    DateTime?
  status        WarehouseItemStatus    @default(in_stock)
  notes         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user          User      @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([createdBy], map: "WarehouseItem_createdBy_fkey")
  @@index([quantity])
  @@index([sku])
  @@index([status])
  @@index([warehouse])
}

model WeightVerification {
  id                      String                    @id @default(cuid())
  tripId          String
  checkpointType  String
  verifiedWeight  Float
  declaredWeight  Float?
  variance        Float?
  variancePercent Float?
  status          WeightVerificationStatus   @default(verified)
  verifiedBy      String?
  verifiedByName  String?
  notes           String?
  location        String?
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([checkpointType])
  @@index([createdAt])
  @@index([status])
  @@index([tripId])
}

model ZoneRate {
  id                      String                    @id @default(cuid())
  destinationZoneId       String
  rateAmount              Decimal
  minMileage              Float?
  maxMileage              Float?
  expectedFuelConsumption Float?
  effectiveDate           DateTime        @default(now())
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt DateTime @updatedAt
  destinationZone         DestinationZone @relation(fields: [destinationZoneId], references: [id])

  @@index([destinationZoneId])
  @@index([isActive])
}

model DvlaRenewalHistory {
  id                  String                    @id @default(cuid())
  dvlaRegistrationId  String
  previousData        String                    @db.Text
  renewalFee          Decimal?
  renewedByName       String?
  notes               String?
  createdAt           DateTime                  @default(now())
  dvlaRegistration    DvlaRegistration         @relation(fields: [dvlaRegistrationId], references: [id], onDelete: Cascade)

  @@index([dvlaRegistrationId])
  @@index([createdAt])
}

model InsuranceRenewalHistory {
  id                  String                    @id @default(cuid())
  insuranceId         String
  previousData        String                    @db.Text
  renewalFee          Decimal?
  renewedByName       String?
  notes               String?
  createdAt           DateTime                  @default(now())
  insurance           Insurance                 @relation(fields: [insuranceId], references: [id], onDelete: Cascade)

  @@index([insuranceId])
  @@index([createdAt])
}
