  notifySpeedingAlert     Boolean  @default(true)
  notifyGeofenceAlert     Boolean  @default(true)
  notifyDriverOffline     Boolean  @default(true)
  notifyDailyReport       Boolean  @default(false)
  smsProvider             String   @default("hubtel")
  smsEnabled              Boolean  @default(false)
  hubtelClientId          String   @default("")
