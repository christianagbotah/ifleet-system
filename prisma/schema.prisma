model TollRecord {
  id              String    @id
  truckId         String
  driverId        String?
  tripId          String?
  tollPoint       String
  tollType        String    @default("toll")
  location        String?
  route           String?
  latitude        Float?
  longitude       Float?
  amount          Float
  paymentMethod   String    @default("cash")
  referenceNumber String?
  tollDate        DateTime
  direction       String?
  status          String    @default("verified")
  disputeReason   String?
  resolvedBy      String?
  resolvedAt      DateTime?
  vehicleWeight   Float?
  overloaded      Boolean   @default(false)
  overloadFine    Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  driver          Driver?   @relation(fields: [driverId], references: [id])
  trip            Trip?     @relation(fields: [tripId], references: [id])
  truck           Truck     @relation(fields: [truckId], references: [id])

  @@index([driverId])
  @@index([route])
  @@index([tollDate])
  @@index([tollType])
  @@index([tripId])
  @@index([truckId, tollDate])
}

model TrackingAlert {
  id             String        @id
  truckId        String
  tripId         String?
  geofenceZoneId String?
  type           String
  title          String
  message        String
  latitude       Float?
  longitude      Float?
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  geofenceZone   GeofenceZone? @relation(fields: [geofenceZoneId], references: [id])
  trip           Trip?         @relation(fields: [tripId], references: [id])
  truck          Truck         @relation(fields: [truckId], references: [id])

  @@index([geofenceZoneId], map: "TrackingAlert_geofenceZoneId_fkey")
  @@index([isRead])
  @@index([tripId], map: "TrackingAlert_tripId_fkey")
  @@index([truckId, createdAt])
  @@index([type])
}

model TrackingConfig {
  id             String   @id
  truckId        String   @unique
  enablePhoneGps Boolean  @default(true)
  enableHardware Boolean  @default(false)
  updateInterval Int      @default(5)
  geofenceRadius Int      @default(500)
  isActive       Boolean  @default(true)
  updatedAt      DateTime
  createdAt      DateTime @default(now())
  truck          Truck    @relation(fields: [truckId], references: [id])
}

model Trip {
  id                      String                    @id
  tripNumber              String                    @unique
  truckId                 String
  driverId                String
  waybillNumber           String?
  orderNumber             String?
  loadingLocation         String
  loadingAddress          String?
  loadingLat              Float?
  loadingLng              Float?
  destination             String
  destinationAddress      String?
  destLat                 Float?
  destLng                 Float?
  itemId                  String?
  itemName                String
  quantity                Float
  unit                    String                    @default("bags")
  unitPrice               Float?
  totalRevenue            Float?
  departureTime           DateTime
  arrivalTime             DateTime?
  estimatedDuration       Float?
  actualDuration          Float?
  startMileage            Float?
  endMileage              Float?
  totalMileage            Float?
  fuelLevelBefore         Float?
  fuelLevelAfter          Float?
  fuelUsed                Float?
  fuelCost                Float?
  startMileageImage       String?
  deliveryType            String                    @default("SINGLE")
  loadingCityId           String?
  loadingPointId          String?
  destinationCityId       String?
  destinationZoneId       String?
  status                  String                    @default("scheduled")
  waitingReason           String?
  waitingSince            DateTime?
  loadingStartedAt        DateTime?
  loadingCompletedAt      DateTime?
  totalOffloaded          Float                     @default(0)
  offloadingStartedAt     DateTime?
  offloadingCompletedAt   DateTime?
  customerName            String?
  customerPhone           String?
  customerRef             String?
  clientId                String?
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  BorderCrossing          BorderCrossing[]
  CashAdvance             CashAdvance[]
  DeliveryStop            DeliveryStop[]
  DepotQueue              DepotQueue[]
  Expense                 Expense[]
  FuelLog                 FuelLog[]
  Invoice                 Invoice?
  RoadConditionReport     RoadConditionReport[]
  SettlementLine          SettlementLine[]
  TollRecord              TollRecord[]
  TrackingAlert           TrackingAlert[]
  client                  Client?                   @relation(fields: [clientId], references: [id])
  destinationCity         DestinationCity?          @relation(fields: [destinationCityId], references: [id])
  destinationZone         DestinationZone?          @relation(fields: [destinationZoneId], references: [id])
  driver                  Driver                    @relation(fields: [driverId], references: [id])
  item                    Item?                     @relation(fields: [itemId], references: [id])
  loadingCity             LoadingCity?              @relation(fields: [loadingCityId], references: [id])
  loadingPoint            LoadingPoint?             @relation(fields: [loadingPointId], references: [id])
  truck                   Truck                     @relation(fields: [truckId], references: [id])
  TripComment             TripComment[]
  TripDeliveryDestination TripDeliveryDestination[]
  TripEvent               TripEvent[]
  TripItem                TripItem[]
  TruckLocation           TruckLocation[]
  VehicleInspection       VehicleInspection[]
  WeightVerification      WeightVerification[]

  @@index([clientId])
  @@index([deliveryType])
  @@index([departureTime])
  @@index([destinationCityId])
  @@index([destinationZoneId])
  @@index([driverId])
  @@index([itemId])
  @@index([loadingCityId])
  @@index([loadingPointId])
  @@index([status, departureTime])
  @@index([status])
  @@index([truckId])
}

model TripComment {
  id        String   @id
  tripId    String
  userId    String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  trip      Trip     @relation(fields: [tripId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tripId, createdAt])
  @@index([userId])
}

model TripDeliveryDestination {
  id                String           @id
  tripId            String
  destinationZoneId String?
  clientId          String?
  customerName      String
  customerPhone     String?
  stopOrder         Int
  status            String           @default("pending")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  actualQty         Float?
  address           String?
  notes             String?
  zoneRate          Float?
  client            Client?          @relation(fields: [clientId], references: [id])
  destinationZone   DestinationZone? @relation(fields: [destinationZoneId], references: [id])
  trip              Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  TripItem          TripItem[]

  @@index([clientId])
  @@index([destinationZoneId])
  @@index([status])
  @@index([tripId])
  @@index([tripId, stopOrder])
}

model TripEvent {
  id         String   @id
  tripId     String
  fromStatus String?
  toStatus   String
  userId     String?
  notes      String?
  location   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())
  trip       Trip     @relation(fields: [tripId], references: [id])

  @@index([tripId, createdAt])
}

model TripItem {
  id                      String                   @id
  tripId                  String
  supplierId              String?
  loadingPointId          String?
  itemId                  String?
  itemName                String
  unit                    String                   @default("bags")
  quantity                Float
  rate                    Float?
  total                   Float?
  sortOrder               Int                      @default(0)
  deliveryDestinationId   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime
  tripDeliveryDestination TripDeliveryDestination? @relation(fields: [deliveryDestinationId], references: [id])
  item                    Item?                    @relation(fields: [itemId], references: [id])
  loadingPoint            LoadingPoint?            @relation(fields: [loadingPointId], references: [id])
  supplier                Supplier?                @relation(fields: [supplierId], references: [id])
  trip                    Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([deliveryDestinationId])
  @@index([itemId])
  @@index([loadingPointId], map: "TripItem_loadingPointId_fkey")
  @@index([supplierId])
  @@index([tripId])
}

model Truck {
  id                   String                 @id
  plateNumber          String                 @unique
  make                 String
  model                String
  year                 Int
  vinNumber            String?                @unique
  engineNumber         String?
  chassisNumber        String?
  color                String?
  fuelType             String                 @default("Diesel")
  tankCapacity         Float?
  status               String                 @default("active")
  currentMileage       Float                  @default(0)
  driverId             String?
  notes                String?
  insuranceStatus      String                 @default("none")
  nextServiceDate      DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  BorderCrossing       BorderCrossing[]
  DepotQueue           DepotQueue[]
  DvlaRegistration     DvlaRegistration[]
  Expense              Expense[]
  FuelBudget           FuelBudget[]
  FuelLog              FuelLog[]
  Insurance            Insurance[]
  InsuranceClaim       InsuranceClaim[]
  LoadBoard            LoadBoard[]
  MaintenanceRecord    MaintenanceRecord[]
  RoadworthyInspection RoadworthyInspection[]
  TollRecord           TollRecord[]
  TrackingAlert        TrackingAlert[]
  TrackingConfig       TrackingConfig?
  Trip                 Trip[]
  driver               Driver?                @relation(fields: [driverId], references: [id])
  TruckLocation        TruckLocation[]
  Tyre                 Tyre[]
  VehicleInspection    VehicleInspection[]

  @@index([driverId], map: "Truck_driverId_fkey")
}

model TruckLocation {
  id        String   @id
  truckId   String
  tripId    String?
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  source    String   @default("phone")
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  trip      Trip?    @relation(fields: [tripId], references: [id])
  truck     Truck    @relation(fields: [truckId], references: [id])

  @@index([tripId])
  @@index([truckId, timestamp])
}

model Tyre {
  id             String    @id
  truckId        String
  serialNumber   String    @unique
  brand          String
  purchaseDate   DateTime
  purchasePrice  Float
  condition      String    @default("new")
  lastInspection DateTime?
  retiredDate    DateTime?
  retiredReason  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  truck          Truck     @relation(fields: [truckId], references: [id])

  @@index([truckId])
}

model VehicleInspection {
  id                  String    @id
  truckId             String
  driverId            String?
  tripId              String?
  type                String
  inspectionDate      DateTime  @default(now())
  odometerReading     Float?
  result              String    @default("pass")
  overallNotes        String?
  checkItems          String
  totalChecks         Int       @default(0)
  passCount           Int       @default(0)
  warningCount        Int       @default(0)
  failCount           Int       @default(0)
  defectsFound        Boolean   @default(false)
  defectDetails       String?   @db.Text
  photos              String?   @db.Text
  inspectedBy         String?
  inspectorName       String?
  signature           String?
  location            String?
  latitude            Float?
  longitude           Float?
  requiresFollowUp    Boolean   @default(false)
  followUpNotes       String?
  followUpCompletedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  driver              Driver?   @relation(fields: [driverId], references: [id])
  trip                Trip?     @relation(fields: [tripId], references: [id])
  truck               Truck     @relation(fields: [truckId], references: [id])

  @@index([driverId])
  @@index([result])
  @@index([tripId])
  @@index([truckId, inspectionDate])
  @@index([type])
}

model WarehouseItem {
  id            String    @id
  name          String
  category      String
  sku           String    @unique
  quantity      Int       @default(0)
  minStock      Int       @default(5)
  unitPrice     Float
  unit          String    @default("pcs")
  warehouse     String    @default("Main Depot")
  location      String?
  supplier      String?
  lastRestocked DateTime?
  expiryDate    DateTime?
  status        String    @default("in_stock")
  notes         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  user          User      @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([createdBy], map: "WarehouseItem_createdBy_fkey")
  @@index([quantity])
  @@index([sku])
  @@index([status])
  @@index([warehouse])
}

model WeightVerification {
  id              String   @id
  tripId          String
  checkpointType  String
  verifiedWeight  Float
  declaredWeight  Float?
  variance        Float?
  variancePercent Float?
  status          String   @default("verified")
  verifiedBy      String?
  verifiedByName  String?
  notes           String?
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  trip            Trip     @relation(fields: [tripId], references: [id])

  @@index([checkpointType])
  @@index([createdAt])
  @@index([status])
  @@index([tripId])
}

model ZoneRate {
  id                      String          @id
  destinationZoneId       String
  rateAmount              Float
  minMileage              Float?
  maxMileage              Float?
  expectedFuelConsumption Float?
  effectiveDate           DateTime        @default(now())
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime
  destinationZone         DestinationZone @relation(fields: [destinationZoneId], references: [id])

  @@index([destinationZoneId])
  @@index([isActive])
}
