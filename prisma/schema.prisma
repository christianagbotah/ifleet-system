generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — Status, Verification, and Condition types
// ─────────────────────────────────────────────────────────────────────────────

enum TripStatus {
  scheduled
  loading
  loaded
  departed_depot
  in_transit
  arrived_destination
  offloading
  offloaded
  return_journey
  arrived_depot
  completed
  cancelled
  delayed
}

enum TruckStatus {
  active
  inactive
  maintenance
  out_of_service
  retired
  decommissioned
}

enum TruckInsuranceStatus {
  none
  active
  expired
  pending
}

enum DriverStatus {
  active
  inactive
  suspended
  resigned
}

enum DriverVerificationStatus {
  pending
  verified
  rejected
  expired
}

enum InvoiceStatus {
  pending
  draft
  sent
  paid
  partially_paid
  overdue
  cancelled
  void
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ExpenseStatus {
  approved
  pending
  rejected
}

enum ExpenseApprovalStatus {
  pending
  approved
  rejected
}

enum MaintenanceStatus {
  pending
  scheduled
  in_progress
  completed
  cancelled
}

enum InsuranceStatus {
  active
  expired
  cancelled
  pending
}

enum ClaimStatus {
  draft
  submitted
  under_review
  approved
  rejected
  paid
  closed
}

enum CashAdvanceStatus {
  pending
  approved
  rejected
  disbursed
  partially_deducted
  fully_deducted
}

enum SettlementStatus {
  pending
  approved
  paid
}

enum LoadBoardStatus {
  open
  assigned
  in_progress
  completed
  cancelled
}

enum BorderCrossingStatus {
  queued
  processing
  cleared
  rejected
}

enum DepotQueueStatus {
  waiting
  in_progress
  loading
  unloading
  completed
  cancelled
}

enum DeliveryStopStatus {
  pending
  arrived
  offloading
  completed
  skipped
}

enum DvlaRegistrationStatus {
  active
  expired
  cancelled
  suspended
}

enum RoadConditionStatus {
  active
  resolved
  dismissed
}

enum TollRecordStatus {
  pending
  verified
  disputed
  resolved
}

enum ReportHistoryStatus {
  pending
  completed
  failed
  cancelled
}

enum WarehouseItemStatus {
  in_stock
  low_stock
  out_of_stock
  expired
  damaged
}

enum WeightVerificationStatus {
  pending
  verified
  failed
  variance_detected
}

enum TyreCondition {
  new
  good
  fair
  worn
  damaged
  retired
}

enum VehicleInspectionResult {
  pass
  conditional_pass
  fail
}

enum TripDeliveryDestinationStatus {
  pending
  in_transit
  arrived
  offloading
  completed
  cancelled
}

enum IncentiveStatus {
  pending
  approved
  rejected
  paid
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                                                  String                @id @default(cuid())
  email                                               String?               @unique
  name                                                String
  phone                                               String?
  password                                            String?
  avatar                                              String?
  roleId                                              String
  position                                            String?
  department                                          String?
  employeeNumber                                      String?               @unique
  isActive                                            Boolean               @default(true)
  lastLogin                                           DateTime?
  createdAt                                           DateTime              @default(now())
  updatedAt                                           DateTime              @updatedAt
  AuditLog                                            AuditLog[]
  BorderCrossing                                      BorderCrossing[]
  DepotQueue                                          DepotQueue[]
  driver                                              Driver?
  driverIncentive_DriverIncentive_approvedByToUser    DriverIncentive[]     @relation("DriverIncentive_approvedByToUser")
  driverIncentive_DriverIncentive_createdByToUser     DriverIncentive[]     @relation("DriverIncentive_createdByToUser")
  expenseApproval_ExpenseApproval_approvedByIdToUser  ExpenseApproval[]     @relation("ExpenseApproval_approvedByIdToUser")
  expenseApproval_ExpenseApproval_requestedByIdToUser ExpenseApproval[]     @relation("ExpenseApproval_requestedByIdToUser")
  InsuranceClaim                                      InsuranceClaim[]
  LoadBoard                                           LoadBoard[]
  Notification                                        Notification[]
  PasswordResetToken                                  PasswordResetToken[]
  RoadConditionReport                                 RoadConditionReport[]
  TripComment                                         TripComment[]
  role                                                Role                  @relation(fields: [roleId], references: [id])
  WarehouseItem                                       WarehouseItem[]

  @@index([isActive])
  @@index([roleId])
}

model AuditLog {
  id                      String                    @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String? 
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model BorderCrossing {
  id                      String                    @id @default(cuid())
  tripId         String
  truckId        String
  driverId       String
  borderName     String
  country        String
  direction      String
  status         BorderCrossingStatus    @default(queued)
  queuedAt       DateTime  @default(now())
  processingAt   DateTime?
  clearedAt      DateTime?
  estimatedWait  Int?
  actualWait     Int?
  clearanceFee   Decimal?
  documentStatus String?
  notes          String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user           User      @relation(fields: [createdBy], references: [id])
  driver         Driver    @relation(fields: [driverId], references: [id])
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  truck          Truck     @relation(fields: [truckId], references: [id])

  @@index([borderName])
  @@index([country])
  @@index([createdBy], map: "BorderCrossing_createdBy_fkey")
  @@index([direction])
  @@index([driverId])
  @@index([queuedAt])
  @@index([status])
  @@index([tripId])
  @@index([truckId])
}

model CashAdvance {
  id                      String                    @id @default(cuid())
  driverId           String
  tripId             String?
  amount             Decimal
  purpose            String
  paymentMethod      String    @default("cash")
  mobileMoneyRef     String?
  mobileMoneyNetwork String?
  status             CashAdvanceStatus    @default(pending)
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?
  disbursedBy        String?
  disbursedAt        DateTime?
  totalDeducted      Decimal     @default(0)
  remainingBalance   Decimal     @default(0)
  requestDate        DateTime  @default(now())
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt DateTime @updatedAt
  driver             Driver    @relation(fields: [driverId], references: [id])
  trip               Trip?     @relation(fields: [tripId], references: [id])

  @@index([driverId, status])
  @@index([requestDate])
  @@index([status])
  @@index([tripId])
}

model Client {
  id                      String                    @id @default(cuid())
  companyName             String
  contactPerson           String
  email                   String?
  phone                   String
  address                 String?
  city                    String?
  region                  String?
  notes                   String?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt DateTime @updatedAt
  ClientZone              ClientZone[]
  Invoice                 Invoice[]
  LoadBoard               LoadBoard[]
  Trip                    Trip[]
  TripDeliveryDestination TripDeliveryDestination[]

  @@index([companyName])
}

model ClientZone {
  id                      String                    @id @default(cuid())
  clientId          String
  destinationZoneId String
  branchName        String?
  address           String?
  contactPerson     String?
  phone             String?
  isPrimary         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destinationZone   DestinationZone @relation(fields: [destinationZoneId], references: [id], onDelete: Cascade)

  @@unique([clientId, destinationZoneId])
  @@index([clientId])
  @@index([destinationZoneId])
}

model Currency {
  id                      String                    @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryStop {
  id                      String                    @id @default(cuid())
  tripId           String
  stopOrder        Int
  destination      String
  address          String?
  lat              Float?
  lng              Float?
  customerName     String?
  customerPhone    String?
  expectedQty      Float
  actualQty        Float?
  unit             String    @default("bags")
  status           DeliveryStopStatus    @default(pending)
  arrivalTime      DateTime?
  offloadStarted   DateTime?
  offloadCompleted DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt DateTime @updatedAt
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, stopOrder])
}

model DepotQueue {
  id                      String                    @id @default(cuid())
  truckId       String
  driverId      String?
  tripId        String?
  depotName     String
  queueType     String
  status        DepotQueueStatus    @default(waiting)
  position      Int?
  estimatedWait Int?
  actualWait    Int?
  joinedAt      DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user          User      @relation(fields: [createdBy], references: [id])
  driver        Driver?   @relation(fields: [driverId], references: [id])
  trip          Trip?     @relation(fields: [tripId], references: [id])
  truck         Truck     @relation(fields: [truckId], references: [id])

  @@index([createdBy], map: "DepotQueue_createdBy_fkey")
  @@index([depotName])
  @@index([driverId], map: "DepotQueue_driverId_fkey")
  @@index([joinedAt])
  @@index([queueType])
  @@index([status])
  @@index([tripId], map: "DepotQueue_tripId_fkey")
  @@index([truckId])
}

model DestinationCity {
  id                      String                    @id @default(cuid())
  name            String            @unique
  region          String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt DateTime @updatedAt
  DestinationZone DestinationZone[]
  Trip            Trip[]

  @@index([isActive])
}

model DestinationZone {
  id                      String                    @id @default(cuid())
  name                    String
  destinationCityId       String
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  ClientZone              ClientZone[]
  destinationCity         DestinationCity           @relation(fields: [destinationCityId], references: [id])
  PerformanceBenchmark    PerformanceBenchmark[]
  Trip                    Trip[]
  TripDeliveryDestination TripDeliveryDestination[]
  ZoneRate                ZoneRate[]

  @@unique([name, destinationCityId])
  @@index([destinationCityId])
  @@index([isActive])
}

model Document {
  id                      String                    @id @default(cuid())
  title       String
  description String?  @db.Text
  category    String
  entityType  String?
  entityId    String?
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([entityType, entityId])
  @@index([uploadedBy])
}

model Driver {
  id                      String                    @id @default(cuid())
  userId              String?             @unique
  firstName           String
  lastName            String
  phone               String              @unique
  email               String?             @unique
  dateOfBirth         DateTime?
  address             String?
  photo               String?
  employeeId          String              @unique
  ghanaCardNumber     String?             @unique
  ghanaCardExpiry     DateTime?
  licenseNumber       String              @unique
  licenseExpiry       DateTime
  licenseClass        String
  licenseImage        String?
  ghanaCardFrontImage String?
  ghanaCardBackImage  String?
  emergencyName       String?
  emergencyPhone      String?
  verificationStatus  DriverVerificationStatus              @default(pending)
  verifiedBy          String?
  verifiedAt          DateTime?
  verificationNotes   String?
  notifySMS           Boolean             @default(true)
  notifyEmail         Boolean             @default(true)
  notifyPush          Boolean             @default(true)
  rating              Float               @default(5)
  status              DriverStatus              @default(active)
  totalTrips          Int                 @default(0)
  totalMileage        Float               @default(0)
  hireDate            DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt DateTime @updatedAt
  BorderCrossing      BorderCrossing[]
  CashAdvance         CashAdvance[]
  DepotQueue          DepotQueue[]
  user                User?               @relation(fields: [userId], references: [id])
  DriverIncentive     DriverIncentive[]
  DriverSettlement    DriverSettlement[]
  DriverWallet        DriverWallet?
  LoadBoard           LoadBoard[]
  Payroll             Payroll[]
  TollRecord          TollRecord[]
  Trip                Trip[]
  Truck               Truck[]
  VehicleInspection   VehicleInspection[]
}

model DriverIncentive {
  id                      String                    @id @default(cuid())
  driverId                              String
  type                                  String
  title                                 String
  description                           String?  @db.Text
  amount                                Decimal
  period                                String
  periodStart                           DateTime?
  periodEnd                             DateTime?
  status                                IncentiveStatus    @default(pending)
  approvedBy                            String?
  approvedAt                            DateTime?
  paidAt                                DateTime?
  metrics                               String?
  createdBy                             String
  createdAt                             DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user_DriverIncentive_approvedByToUser User?     @relation("DriverIncentive_approvedByToUser", fields: [approvedBy], references: [id])
  user_DriverIncentive_createdByToUser  User      @relation("DriverIncentive_createdByToUser", fields: [createdBy], references: [id])
  driver                                Driver    @relation(fields: [driverId], references: [id])

  @@index([amount])
  @@index([approvedBy], map: "DriverIncentive_approvedBy_fkey")
  @@index([createdBy], map: "DriverIncentive_createdBy_fkey")
  @@index([driverId])
  @@index([period])
  @@index([status])
  @@index([type])
}

model DriverSettlement {
  id                      String                    @id @default(cuid())
  driverId          String
  period            String
  periodStart       DateTime
  periodEnd         DateTime
  grossEarnings     Decimal
  fuelDeductions    Decimal
  expenseDeductions Decimal
  bonusAmount       Decimal
  netPay            Decimal
  status            SettlementStatus           @default(pending)
  approvedBy        String?
  approvedAt        DateTime?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt DateTime @updatedAt
  driver            Driver           @relation(fields: [driverId], references: [id])
  SettlementLine    SettlementLine[]

  @@index([driverId, period])
  @@index([periodEnd])
  @@index([periodStart])
  @@index([status])
}

model DriverWallet {
  id                      String                    @id @default(cuid())
  driverId                 String    @unique
  availableBalance         Decimal     @default(0)
  totalAdvances            Decimal     @default(0)
  totalDeducted            Decimal     @default(0)
  totalSettled             Decimal     @default(0)
  monthlyAdvanceLimit      Decimal?
  monthlyAdvancesThisMonth Decimal     @default(0)
  lastAdvanceDate          DateTime?
  mobileMoneyNumber        String?
  mobileMoneyNetwork       String?
  preferredPaymentMethod   String    @default("cash")
  createdAt                DateTime  @default(now())
  updatedAt DateTime @updatedAt
  driver                   Driver    @relation(fields: [driverId], references: [id])
}

model DvlaRegistration {
  id                      String                    @id @default(cuid())
  truckId            String
  registrationNumber String    @unique
  certificateNumber  String    @unique
  vehicleClass       String
  bodyType           String?
  axleConfiguration  String?
  grossVehicleWeight Float?
  unladenWeight      Float?
  seatingCapacity    Int?
  engineCapacity     String?
  yearOfManufacture  Int?
  countryOfOrigin    String?
  registeredOwner    String
  ownerAddress       String?
  ownerContact       String?
  dvlaOffice         String?
  registrationDate   DateTime
  expiryDate         DateTime
  lastRenewalDate    DateTime?
  nextRenewalDue     DateTime?
  registrationFee    Decimal?
  renewalFee         Decimal?
  status             DvlaRegistrationStatus    @default(active)
  documentUrl        String?
  transferHistory    String?   @db.Text
  notes              String?
  reminderSent       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt DateTime @updatedAt
  truck              Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  DvlaRenewalHistory DvlaRenewalHistory[]

  @@index([expiryDate])
  @@index([registeredOwner])
  @@index([truckId, status])
  @@index([vehicleClass])
}

model Expense {
  id                      String                    @id @default(cuid())
  truckId         String
  category        String
  description     String
  amount          Decimal
  date            DateTime
  paymentMethod   String           @default("cash")
  reference       String?
  approvedBy      String?
  status          ExpenseStatus           @default(approved)
  receiptUrl      String?
  tripId          String?
  createdAt       DateTime         @default(now())
  updatedAt DateTime @updatedAt
  trip            Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  truck           Truck            @relation(fields: [truckId], references: [id])
  ExpenseApproval ExpenseApproval?

  @@index([category])
  @@index([date])
  @@index([status])
  @@index([tripId])
  @@index([truckId, date])
}

model ExpenseApproval {
  id                      String                    @id @default(cuid())
  expenseId                                String    @unique
  status                                   ExpenseApprovalStatus    @default(pending)
  requestedById                            String
  approvedById                             String?
  approvalLevel                            Int       @default(1)
  amount                                   Decimal
  approvedAmount                           Decimal?
  notes                                    String?
  rejectionReason                          String?
  reviewedAt                               DateTime?
  createdAt                                DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user_ExpenseApproval_approvedByIdToUser  User?     @relation("ExpenseApproval_approvedByIdToUser", fields: [approvedById], references: [id])
  expense                                  Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user_ExpenseApproval_requestedByIdToUser User      @relation("ExpenseApproval_requestedByIdToUser", fields: [requestedById], references: [id])

  @@index([approvedById])
  @@index([createdAt])
  @@index([expenseId])
  @@index([requestedById])
  @@index([status])
}

model FuelBudget {
  id                      String                    @id @default(cuid())
  truckId      String?
  month        Int
  year         Int
  budgetLimit  Decimal
  litersLimit  Float?
  actualSpend  Decimal    @default(0)
  actualLiters Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy    String?
  truck        Truck?   @relation(fields: [truckId], references: [id])

  @@unique([truckId, month, year])
  @@index([month])
  @@index([truckId])
  @@index([year])
}

model FuelLog {
  id                      String                    @id @default(cuid())
  tripId          String
  truckId         String
  date            DateTime @default(now())
  odometer        Float?
  fuelLevelBefore Float?
  fuelLevelAfter  Float?
  litersFilled    Float
  costPerLiter    Decimal?
  totalCost       Decimal
  stationName     String?
  fuelType        String   @default("Diesel")
  receiptNumber   String?
  endMileage      Float?
  endMileageImage String?   @db.Text
  images          String?   @db.Text // JSON array of uploaded image URLs (receipts, fuel logs, mileage photos)
  distanceCovered Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  truck           Truck    @relation(fields: [truckId], references: [id])

  @@index([date])
  @@index([fuelType])
  @@index([tripId])
  @@index([truckId])
}

model FuelPrice {
  id                      String                    @id @default(cuid())
  stationId     String
  fuelType      String
  pricePerLiter Decimal
  effectiveDate DateTime    @default(now())
  source        String      @default("manual")
  verified      Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt DateTime @updatedAt
  fuelStation   FuelStation @relation(fields: [stationId], references: [id])

  @@unique([stationId, fuelType, effectiveDate])
  @@index([effectiveDate])
  @@index([fuelType])
}

model FuelStation {
  id                      String                    @id @default(cuid())
  name                  String
  brand                 String
  stationCode           String?     @unique
  address               String?
  city                  String?
  region                String?
  latitude              Float?
  longitude             Float?
  route                 String?
  phone                 String?
  email                 String?
  operatingHours        String?
  hasCardPayment        Boolean     @default(false)
  hasLoyaltyProgram     Boolean     @default(false)
  hasHGV                Boolean     @default(true)
  hasAdBlue             Boolean     @default(false)
  hasWorkshop           Boolean     @default(false)
  corporateRatePerLiter Decimal?
  rating                Float?
  totalRatings          Int         @default(0)
  isActive              Boolean     @default(true)
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt DateTime @updatedAt
  FuelPrice             FuelPrice[]

  @@index([brand])
  @@index([city])
  @@index([route])
}

model GeofenceZone {
  id                      String                    @id @default(cuid())
  name          String
  latitude      Float
  longitude     Float
  radius        Int             @default(500)
  type          String          @default("depot")
  address       String?
  createdAt     DateTime        @default(now())
  updatedAt DateTime @updatedAt
  TrackingAlert TrackingAlert[]

  @@index([type])
}

model Insurance {
  id                      String                    @id @default(cuid())
  truckId             String
  provider            String
  policyNumber        String           @unique
  type                String
  coverAmount         Decimal?
  premium             Decimal
  startDate           DateTime
  endDate             DateTime
  status              InsuranceStatus           @default(active)
  renewalReminderSent Boolean          @default(false)
  documentUrl         String?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt DateTime @updatedAt
  truck               Truck            @relation(fields: [truckId], references: [id])
  InsuranceClaim      InsuranceClaim[]
  InsuranceRenewalHistory InsuranceRenewalHistory[]

  @@index([endDate])
  @@index([truckId, status])
}

model InsuranceClaim {
  id                      String                    @id @default(cuid())
  insuranceId       String
  truckId           String
  claimNumber       String    @unique
  claimType         String
  incidentDate      DateTime
  incidentLocation  String
  description       String    @db.Text
  status            ClaimStatus    @default(draft)
  claimAmount       Decimal
  approvedAmount    Decimal?
  deductible        Decimal?
  assignedAdjuster  String?
  policeReport      String?   @db.Text
  thirdPartyDetails String?   @db.Text
  damagePhotos      String?   @db.Text
  repairEstimate    Decimal?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  paidAt            DateTime?
  closedAt          DateTime?
  notes             String?   @db.Text
  assessorNotes     String?   @db.Text
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user              User      @relation(fields: [createdBy], references: [id])
  insurance         Insurance @relation(fields: [insuranceId], references: [id])
  truck             Truck     @relation(fields: [truckId], references: [id])

  @@index([claimAmount])
  @@index([claimType])
  @@index([createdBy], map: "InsuranceClaim_createdBy_fkey")
  @@index([incidentDate])
  @@index([insuranceId])
  @@index([status])
  @@index([truckId])
}

model Invoice {
  id                      String                    @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  tripId        String?       @unique
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus        @default(draft)
  subtotal      Decimal
  taxAmount     Decimal         @default(0)
  taxRate       Decimal         @default(0)
  totalAmount   Decimal
  paidAmount    Decimal         @default(0)
  notes         String?
  terms         String?
  createdAt     DateTime      @default(now())
  updatedAt DateTime @updatedAt
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trip          Trip?         @relation(fields: [tripId], references: [id])
  InvoiceItem   InvoiceItem[]

  @@index([clientId])
  @@index([dueDate])
  @@index([issueDate])
  @@index([status])
}

model InvoiceItem {
  id                      String                    @id @default(cuid())
  invoiceId   String
  description String    @db.Text
  quantity    Decimal
