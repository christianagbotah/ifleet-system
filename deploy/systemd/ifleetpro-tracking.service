[Unit]
Description=iFleetPro Live Tracking Socket Service
After=network-online.target ifleetpro.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lightworld/webapps/ifleetpro/mini-services/tracking-service
Environment=NODE_ENV=production
Environment=PORT=3033
Environment=HOST=127.0.0.1
Environment=APP_BASE_URL=http://127.0.0.1:3000
ExecStart=/root/.bun/bin/bun index.ts
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
