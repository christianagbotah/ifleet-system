[Unit]
Description=iFleetPro GitHub Webhook Listener
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ifleetpro/app
ExecStart=/usr/local/bin/webhook -nopanic -hooks /home/ifleetpro/app/hooks.json -verbose -port 9000 -http-methods POST
Restart=always
RestartSec=5
StandardOutput=append:/home/ifleetpro/logs/webhook.out.log
StandardError=append:/home/ifleetpro/logs/webhook.error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
