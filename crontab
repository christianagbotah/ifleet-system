# ============================================================
# Crontab — webDevReview auto code-quality review
# Schedule: Every 15 minutes
# Timezone: Africa/Accra (CRON_TZ)
# ============================================================

CRON_TZ=Africa/Accra

# ── webDevReview ──────────────────────────────────────────
# Name       : webDevReview
# Kind       : fixed_rate (every 15 minutes)
# Expression : */15 * * * *
# Timezone   : Africa/Accra
# Command    : cd /home/z/my-project && bun run lint 2>&1 | grep -v "ifleet-fresh" | tail -5
# ──────────────────────────────────────────────────────────
*/15 * * * * cd /home/z/my-project && bun run lint 2>&1 | grep -v "ifleet-fresh" | tail -5

# ── iFleetPro telematics history compaction ─────────────────
# Daily at 02:15 Africa/Accra. The compactor is idempotent and writes summaries
# before deleting only redundant interior location points.
15 2 * * * cd /home/lightworld/webapps/ifleetpro && NODE_ENV=production /root/.bun/bin/bun .next/standalone/scripts/compact-location-history.ts >> /home/lightworld/logs/ifleetpro-telematics-compaction.log 2>&1

# ── iFleetPro video retention cleanup ────────────────────────
# Daily at 02:45 Africa/Accra. The script defaults to dry-run; this scheduled
# production invocation explicitly applies retention to iFleetPro-managed copies only.
45 2 * * * cd /home/lightworld/webapps/ifleetpro && NODE_ENV=production /root/.bun/bin/bun scripts/video-retention-cleanup.ts --apply >> /home/lightworld/logs/ifleetpro-video-retention.log 2>&1
